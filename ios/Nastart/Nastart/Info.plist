<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>picture-in-picture</string>
	</array>
		<key>UIRequiresFullScreen</key>
		<true/>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Viewer</string>
				<key>CFBundleURLName</key>
				<string>com.changliwen.nastart.external-playback</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>nastart</string>
				</array>
			</dict>
		</array>
		<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>infuse</string>
		<string>filebox</string>
		<string>open-vidhub</string>
		<string>vlc-x-callback</string>
		<string>outplayer</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_https._tcp.</string>
		<string>_http._tcp.</string>
		<string>_smb._tcp.</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Nastart uses your local network to discover and connect to your NAS and Nastart Agent.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
