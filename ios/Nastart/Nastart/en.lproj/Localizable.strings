"help.privacy.transport.title" = "Connection protocol";
"help.privacy.transport.body" = "WebDAV supports HTTP and HTTPS. HTTP does not encrypt traffic; use HTTPS when the service supports it. Check the connection settings and the actual service for its address and certificate status.";
"help.privacy.sync.title" = "On-device & cross-device data";
"help.privacy.sync.body" = "Network library indexes are stored in the app, while Jellyfin manages viewing progress on its server. iCloud sync applies only to supported items. Apple TV does not currently use iCloud sync or automatically copy accounts and data from iPhone or iPad.";
"help.remote.title" = "Remote & iPhone keyboard";
"help.remote.subtitle" = "Selection, navigation and typing";
