"help.media.subtitle" = "Posters, details and playback controls";
"help.media.posters.title" = "Posters & film details";
"help.media.posters.body" = "Browse films and series on the poster wall, then open a title to read its summary and credits. Details and artwork depend on the available library information; some titles may be missing a cover or person photo.";
"help.media.files.title" = "Read-only library indexing";
"help.media.files.body" = "WebDAV indexing reads files, existing NFO metadata and artwork within the selected folder. The index stays in the app without changing NAS files, names or folders. A standalone online film metadata service is not connected yet.";
"help.media.controls.title" = "Playback controls";
"help.media.controls.body" = "Pause, resume and seek during playback. Available audio tracks, subtitles and other controls depend on the media and active player. Connection quality and file format also affect loading and seeking.";
