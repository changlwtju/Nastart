"help.connection.library.title" = "Libraries & folders";
"help.connection.library.body" = "Jellyfin uses libraries configured on its server. With WebDAV, connect and choose a media folder. Reuse a saved connection in connection management to add another folder.";
"help.connection.edit.title" = "Edit a connection or folder";
"help.connection.edit.body" = "Edit connection details in connection management. When changing a media folder, the new directory is checked and read before the local index is replaced. Cancelling or an incomplete check keeps the existing library.";
