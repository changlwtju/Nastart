  "behavior": [
    "retain UTF8 filename bytes as text without trimming spaces or percent decoding",
    "file/dir parsed; cdir/pdir skipped without following absolute names; unknown types/symlinks/missing type reject full listing",
    "facts ASCII syntax before case folding; duplicate case-insensitive fact names or canonical-equivalent entry names reject",
    "optional size/modify/unique remain optional; Int64 size and UTC calendar time validated; modify raw fractional representation retained",
    "32KiB/1024-byte line/256 entries/16 special directories/32 facts/255-byte name bounds",
    "parse only after data EOF and final 226; any invalid later row yields no partial result"
  ],
  "preservedBaseline": "Kelvin-sign Unicode fact key was accepted after lowercasing; original output and parser source retained, raw-key ASCII guard added",
  "limitations": [
    "private prototype only; no App dependency, signing, embedding, device regression or installation",
    "no MLST, RETR/NFO version checks, production directory source, recursive scanner or local index transaction",
    "no explicit AUTH TLS data upgrade or FTPS session reuse",
    "strict bounded subset: legal fact-less listings and unsupported types rejected; name/fraction bounds are client policy, not universal RFC limits",
    "no atomic scope proof from safe text names; SMB root containment failure remains open",
    "unique is an opaque filesystem hint, not a media provider ID or sufficient content-version proof",
    "no TSan or leak proof; ASan detect_leaks=0"
  ],
